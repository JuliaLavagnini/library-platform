# Settings for `docker compose`. Copy this file to .env and fill it in.
# .env is ignored by git: never commit real keys or passwords.

# Key user-service signs login tokens with. Generate one with:
#   npm run keys:generate
# If left empty, a temporary key is used and everyone is logged out whenever
# user-service restarts.
JWT_PRIVATE_KEY=

# The first librarian account, created on startup if no librarian exists yet.
# Password: at least 12 characters.
BOOTSTRAP_LIBRARIAN_EMAIL=librarian@library.local
BOOTSTRAP_LIBRARIAN_PASSWORD=
